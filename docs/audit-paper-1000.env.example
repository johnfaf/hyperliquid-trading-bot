# Load only in a separate research process or container. Do not source an
# existing production env file. Use a new database, model directory and port.
HL_BOT_DB=/data/audit-paper-1000.db
HL_BOT_BACKUP=/data/audit-paper-1000-backup.json
RUNTIME_CONFIG_OVERRIDE_FILE=/data/audit-paper-1000-config.json
LIVE_EXTERNAL_KILL_SWITCH_FILE=/data/audit-paper-1000-stop
LIVE_KILL_SWITCH_STATE_FILE=/data/audit-paper-1000-stop-state.json
LSTM_MODEL_DIR=/data/audit-paper-1000-models
DASHBOARD_HOST=127.0.0.1
PORT=18081
DB_BACKEND=sqlite
PAPER_TRADING_INITIAL_BALANCE=1000
PAPER_TRADING_MAX_LEVERAGE=1
SL_MIN_HOLD_SECONDS=0
PAPER_TRADING_MAKER_FEE_BPS=1.5
PAPER_TRADING_TAKER_FEE_BPS=4.5
PAPER_TRADING_DEFAULT_EXECUTION_ROLE=taker
LIVE_TRADING_ENABLED=false
LIVE_TRADING_DUAL_CONTROL_CONFIRM=false
LIGHTER_LIVE_TRADING_ENABLED=false
LIGHTER_LIVE_TRADING_DUAL_CONTROL_CONFIRM=false
LIVE_SCHEDULE_CANCEL_ENABLED=false
LIVE_PROMOTION_GATE_ENABLED=true
LIVE_PROMOTION_GATE_FAIL_OPEN=false
HEDGER_DRY_RUN=true
SECRET_MANAGER_PROVIDER=none
ENABLE_LSTM_AGENT=false
ENABLE_RL_SIZER=false
COPY_TRADER_ENABLED=false
ROTATION_ENGINE_ENABLED=false
AUTO_BACKTEST_LOOP_ENABLED=false
