[Unit]
Description=US stock paper/shadow reconciliation and strategy cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
User=hyperliquid-stock-paper
StateDirectory=hyperliquid-stock-paper
StateDirectoryMode=0700
EnvironmentFile=-/etc/hyperliquid-stock-paper/paper.env
ExecStart=/usr/bin/python3 -I -B /opt/hyperliquid-stock-paper/current/scripts/run_stock_paper.py --db /var/lib/hyperliquid-stock-paper/orders.sqlite3
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
